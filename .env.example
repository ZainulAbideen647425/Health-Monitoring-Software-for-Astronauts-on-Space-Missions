# Copy to .env to override defaults. Never commit the real .env file.
ASTRONAUT_HEALTH_MONITOR_DATABASE_URL=sqlite:///./astronaut_health_monitor.db
ASTRONAUT_HEALTH_MONITOR_APPLICATION_TITLE=Astronaut Health Monitor

# Encryption key for stored health data (names, measured values, notes). Generate one with:
#   python -c "from astronaut_health_monitor.core.field_encryption import generate_encryption_key as g; print(g())"
# If left empty, a key file named .data_encryption_key is created next to the app. Back it up: without the key the
# encrypted data cannot be read.
ASTRONAUT_HEALTH_MONITOR_ENCRYPTION_KEY=

# Set to true when the app is served over HTTPS so the session cookie is only sent over encrypted connections.
ASTRONAUT_HEALTH_MONITOR_SECURE_COOKIES=false

# Demo mode creates sample data and three demo accounts with a PUBLIC password. Never use it with real data.
ASTRONAUT_HEALTH_MONITOR_DEMO_MODE=false

# Let people create their own astronaut account from the sign-in screen (true/false).
ASTRONAUT_HEALTH_MONITOR_ALLOW_SELF_REGISTRATION=true
